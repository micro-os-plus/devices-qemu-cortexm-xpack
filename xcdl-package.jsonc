{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2022-2026 Liviu Ionescu. All rights reserved.",
  "description": "Top QEMU Cortex-M components",
  "cdlComponents": [
    {
      "id": "micro-os-plus.devices.qemu-cortexm",
      "alias": "micro-os-plus.device",
      "display": "QEMU Cortex-M devices",
      "description": "The QEMU Cortex-M devices definitions",
      "publicIncludeFolders": [
        "include"
      ],
      "sourceFiles": [
        "src/system-cortexm.c"
      ],
      "$comment": "Clarify how to use the device definition, known in the platform",
      "dependencies": [
        "micro-os-plus.diag.trace",
        "micro-os-plus.architecture",
        "xpack-3rd-party.arm-cmsis-core-cortex-m",
        // This introduces a circular dependency.
        // "micro-os-plus.semihosting",
      ],
      "implementedInterfaces": [
        "micro-os-plus.device"
      ],
      "generatedFile": {
        "type": "c-header",
        "filePath": "{{buildFolderPath}}/generated/include/micro-os-plus/device-defines.h"
      },
      // "defaultDefine": "MICRO_OS_PLUS_DEVICES_QEMU_CORTEXM_ENABLED",
      "cdlOptions": [
        {
          "id": "core",
          "display": "CPU core",
          "description": "Select the QEMU Cortex-M CPU",
          "valueType": "string",
          "legalValues": [
            "m0",
            "m0plus",
            "m3",
            "m4",
            "m7",
            "m23"
          ],
          "customDefine": "MICRO_OS_PLUS_DEVICE_QEMU_CORTEX"
        }
      ]
    },
    {
      "id": "micro-os-plus.devices.qemu-cortexm.vectors-generic",
      "display": "Cortex-M generic vectors",
      "description": "The Cortex-M generic interrupt vectors",
      "sourceFiles": [
        "src/vectors-generic.c"
      ],
      "dependencies": [
        "micro-os-plus.architecture"
      ]
      // "defaultDefine": "MICRO_OS_PLUS_DEVICE_QEMU_CORTEXM_VECTORS_GENERIC_ENABLED"
    },
    {
      "id": "micro-os-plus.devices.qemu-cortexm.vectors-mps2-an385",
      "display": "MPS2-AN385 vectors",
      "description": "The MPS2-AN385 interrupt vectors",
      "sourceFiles": [
        "src/vectors-mps2-an385.c"
      ],
      "dependencies": [
        "micro-os-plus.architecture"
      ],
      // "defaultDefine": "MICRO_OS_PLUS_DEVICE_QEMU_CORTEXM_VECTORS_MPS2_AN385_ENABLED"
    },
    {
      "id": "micro-os-plus.devices.qemu-cortexm.vectors-mps2-an386",
      "display": "MPS2-AN386 vectors",
      "description": "The MPS2-AN386 interrupt vectors",
      "sourceFiles": [
        "src/vectors-mps2-an386.c"
      ],
      "dependencies": [
        "micro-os-plus.architecture"
      ],
      // "defaultDefine": "MICRO_OS_PLUS_DEVICE_QEMU_CORTEXM_VECTORS_MPS2_AN386_ENABLED"
    },
    {
      "id": "micro-os-plus.devices.qemu-cortexm.vectors-mps2-an500",
      "display": "MPS2-AN500 vectors",
      "description": "The MPS2-AN500 interrupt vectors",
      "sourceFiles": [
        "src/vectors-mps2-an500.c"
      ],
      "dependencies": [
        "micro-os-plus.architecture"
      ],
      // "defaultDefine": "MICRO_OS_PLUS_DEVICE_QEMU_CORTEXM_VECTORS_MPS2_AN500_ENABLED"
    },
    {
      "id": "micro-os-plus.devices.qemu-cortexm.vectors-mps2-an505",
      "display": "MPS2-AN505 vectors",
      "description": "The MPS2-AN505 interrupt vectors",
      "sourceFiles": [
        "src/vectors-mps2-an505.c"
      ],
      "dependencies": [
        "micro-os-plus.architecture"
      ],
      // "defaultDefine": "MICRO_OS_PLUS_DEVICE_QEMU_CORTEXM_VECTORS_MPS2_AN505_ENABLED"
    }
  ]
}